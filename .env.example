# Copia este archivo como .env y asigna valores largos y únicos.
POSTGRES_DB=conecta_echegaray
POSTGRES_USER=conecta
POSTGRES_PASSWORD=cambia-esta-contrasena-por-una-larga
DATABASE_URL=postgresql://conecta:cambia-esta-contrasena-por-una-larga@db:5432/conecta_echegaray
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=elige-una-contrasena-larga-y-unica
SESSION_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres

# En producción, siempre true. Para pruebas locales HTTP, false.
COOKIE_SECURE=true
